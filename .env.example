# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# CASHFREE PAYMENT GATEWAY CONFIGURATION
# Obtain credentials from your Cashfree Merchant Dashboard:
# Sandbox: https://sandbox.cashfree.com/merchants
# Production: https://merchant.cashfree.com
CASHFREE_APP_ID="your_cashfree_app_id_here"
CASHFREE_SECRET_KEY="your_cashfree_secret_key_here"
CASHFREE_ENVIRONMENT="SANDBOX"
CASHFREE_API_VERSION="2023-08-01"

# Backend Server Port
PORT=5000

# OPTIONAL: MULTI-HOST DEPLOYMENT (RENDER + VERCEL)
# Set BACKEND_URL on Render (e.g. https://blueblends-backend.onrender.com) so Cashfree webhooks hit Render directly.
BACKEND_URL="https://your-backend.onrender.com"
# Set VITE_API_URL on Vercel (e.g. https://blueblends-backend.onrender.com) so frontend calls the Render backend.
VITE_API_URL="https://your-backend.onrender.com"

